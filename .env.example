NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_EMULATORS=true

# Server only (Vercel env vars). Never NEXT_PUBLIC_.
CRON_SECRET=
# Service-account JSON for firebase-admin (verifying ID tokens, sending FCM) on the deployed app.
FIREBASE_SERVICE_ACCOUNT=
# Postgres. Production: Neon's pooled connection string (…-pooler…neon.tech/…?sslmode=require), server only.
# Local: `npm run db` serves PGlite on this URL, no account or install needed.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# Web push (CO-26): Firebase console → Project settings → Cloud Messaging → Web Push certificates.
# Public by design. Unset = the app asks for permission but saves no token.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# CO-39: GitHub repo URL (https://github.com/<owner>/<repo>) for the landing's "Release notes" link to CHANGELOG.md.
# Unset = the link is hidden.
NEXT_PUBLIC_REPO_URL=
